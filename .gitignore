# Output of `python -m src.infer` next to its input
*_scored.csv

# Local guard written by src/evaluate.py (records which model was evaluated on the
# test split). Committing it would make every clone refuse to re-evaluate that model.
reports/.test_eval_lock.json

# Dataset: not committed by default. Only add it if you have the right to publish it
# (then delete the next line, or force-add with: git add -f data/thms_dataset.csv).
data/*.csv
